{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poparooz-email-gate-prod",
  "main": "worker/email-gate/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "EMAIL_GATE_DB",
      "database_name": "poparooz-email-gate-prod",
      "database_id": "6a2833a3-3825-43cf-8a76-9ac0943bc93b",
      "migrations_dir": "worker/email-gate/migrations",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
}
