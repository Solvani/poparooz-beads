{
  "name": "poparooz-beads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node scripts/benchmarks/run-benchmark.mjs --write",
    "quality:generator": "node scripts/quality/generator/run-generator-quality.mjs --corpus synthetic",
    "quality:generator:curated": "node scripts/quality/generator/run-generator-quality.mjs --corpus external --manifest data-source/quality/generator-corpus/1.0.0/manifest.json",
    "quality:generator:h03-candidate": "node scripts/quality/generator/run-h03-candidate-evaluation.mjs",
    "color-set:compile": "node --experimental-strip-types --import ./scripts/palette/runtime/register-typescript-extension-loader.mjs scripts/palette/color-set/compile-color-set-profiles.ts",
    "color-set:lock": "node --experimental-strip-types --import ./scripts/palette/runtime/register-typescript-extension-loader.mjs scripts/palette/color-set/generate-color-set-lock.ts",
    "color-set:verify": "node --experimental-strip-types --import ./scripts/palette/runtime/register-typescript-extension-loader.mjs scripts/palette/color-set/verify-color-set-production-gate-cli.ts",
    "palette:runtime:compile": "node --experimental-strip-types --import ./scripts/palette/runtime/register-typescript-extension-loader.mjs scripts/palette/runtime/compile-runtime-palette.ts",
    "palette:runtime:lock": "node --experimental-strip-types --import ./scripts/palette/runtime/register-typescript-extension-loader.mjs scripts/palette/runtime/generate-runtime-palette-lock.ts",
    "palette:runtime:verify": "node --experimental-strip-types --import ./scripts/palette/runtime/register-typescript-extension-loader.mjs scripts/palette/runtime/verify-runtime-palette-production-gate-cli.ts",
    "palette:validate": "node --experimental-strip-types scripts/palette/validate-palette.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "csv-parse": "^7.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "exceljs": "4.4.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.126.0"
  }
}
